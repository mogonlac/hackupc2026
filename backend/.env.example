# Copy this to .env and fill in your values

SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_APP_TOKEN=xapp-your-app-token   # only needed for Socket Mode

PORT=3001

# Channel to listen for work-request messages (name or ID)
SLACK_CHANNEL_ID=C0123456789

# GitHub PR flow (optional): after you click Merge in Slack, pull the same repo on this machine
# so local files (e.g. demo/) match GitHub. Use the folder that contains `.git`.
# GITHUB_LOCAL_REPO=C:/Users/you/slap2
